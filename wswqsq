### ৪. ফ্রন্টএন্ড কোড স্নsnippet (Copy-Paste Ready)

আপনার অ্যাপে `src/services/pushNotification.ts` ফাইলে নিচের কোডটি রাখতে পারেন:

```typescript
import * as Notifications from 'expo-notifications';
import { Platform } from 'react-native';
import apiClient from './apiClient'; // আপনার তৈরি করা axios/fetch ক্লায়েন্ট

// ১. নোটিফিকেশন পপআপ কেমন দেখাবে তার কনফিগারেশন
Notifications.setNotificationHandler({
  handleNotification: async () => ({
    shouldShowAlert: true,
    shouldPlaySound: true,
    shouldSetBadge: true,
  }),
});

// ২. পারমিশন নিয়ে ব্যাকএন্ডে টোকেন রেজিস্টার করার ফাংশন
export async function registerForPushNotificationsAsync(): Promise<string | null> {
  let token: string | null = null;

  // Android এর জন্য চ্যানেল সেটআপ
  if (Platform.OS === 'android') {
    await Notifications.setNotificationChannelAsync('default', {
      name: 'default',
      importance: Notifications.AndroidImportance.MAX,
      vibrationPattern: [0, 250, 250, 250],
      lightColor: '#FF231F7C',
    });
  }

  // পারমিশন চেক
  const { status: existingStatus } = await Notifications.getPermissionsAsync();
  let finalStatus = existingStatus;

  if (existingStatus !== 'granted') {
    const { status } = await Notifications.requestPermissionsAsync();
    finalStatus = status;
  }

  if (finalStatus !== 'granted') {
    console.log('Push notification permission denied by user.');
    return null;
  }

  try {
    // ⚠️ নেটিভ FCM টোকেন নিন
    const devicePushToken = await Notifications.getDevicePushTokenAsync();
    token = devicePushToken.data;

    // ব্যাকএন্ডে টোকেন পাঠান
    await apiClient.post('/api/v1/notifications/device-token', {
      token: token,
    });
    console.log('Push token successfully registered:', token);
  } catch (error) {
    console.error('Failed to register device token:', error);
  }

  return token;
}

// ৩. লগআউটের সময় টোকেন ডিলিট করার ফাংশন
export async function unregisterPushNotificationAsync(): Promise<void> {
  try {
    const devicePushToken = await Notifications.getDevicePushTokenAsync();
    if (devicePushToken?.data) {
      await apiClient.delete('/api/v1/notifications/device-token', {
        data: { token: devicePushToken.data },
      });
    }
  } catch (error) {
    console.warn('Failed to unregister push token:', error);
  }
}
```

এই ডকটি ফ্রন্টএন্ড ডেভেলপারকে পাঠিয়ে দিলেই সে কোনো কনফিউশন ছাড়াই ৫ মিনিটে ইন্টিগ্রেশন করে ফেলতে পারবে।