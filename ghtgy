#### স্ক্রিন ৪: Live Ride Tracking / Job Details Screen (উভয়ের জন্য)
ড্রাইভার বা ক্রিয়েটর যখন জব ডিটেইলস স্ক্রিনে থাকবে, তখন রাইড স্ট্যাটাস লাইভ আপডেট দেখতে পাবে।

```typescript
// screens/JobDetailsScreen.tsx
useEffect(() => {
  const socket = getSocket();
  if (!socket || !jobId) return;

  // ১. এই নির্দিষ্ট জবের রুমে জয়েন করুন
  socket.emit('JOIN_JOB', { jobId });

  // ২. লাইভ রাইড স্ট্যাটাস প্রগ্রেস (ON THE WAY -> AT THE LOCATION -> POB -> FINISHED)
  const handleRideStatusUpdated = ({ jobId: updatedId, rideStatus, status }: any) => {
    if (updatedId === jobId) {
      setCurrentRideStatus(rideStatus); // লাইভ স্টেপার/ম্যাপ আপডেট
    }
  };

  // ৩. যদি জবটি ক্যান্সেল করা হয়
  const handleJobCancelled = ({ jobId: cancelledId }: any) => {
    if (cancelledId === jobId) {
      alert('This ride has been cancelled by the creator.');
      navigation.goBack();
    }
  };

  socket.on('RIDE_STATUS_UPDATED', handleRideStatusUpdated);
  socket.on('JOB_CANCELLED', handleJobCancelled);

  return () => {
    // স্ক্রিন থেকে বের হওয়ার সময় লিভ করুন এবং ইভেন্ট লিসনার রিমুভ করুন
    socket.emit('LEAVE_JOB', { jobId });
    socket.off('RIDE_STATUS_UPDATED', handleRideStatusUpdated);
    socket.off('JOB_CANCELLED', handleJobCancelled);
  };
}, [jobId]);
```

