#### স্ক্রিন ২: My Created Jobs Screen (অপারেটর / জব ক্রিয়েটরের জন্য)
ড্রাইভার যখন জবটিতে অ্যাপ্লাই করবে, রিফ্রেশ ছাড়াই সাথে সাথে ব্যাজ বা নোটিফিকেশন আপডেট হবে।

```typescript
// screens/MyJobsScreen.tsx
useEffect(() => {
  const socket = getSocket();
  if (!socket) return;

  // ড্রাইভার অ্যাপ্লাই করলে
  const handleApplicationReceived = (data: { jobId: string; applicant: any }) => {
    // UI-তে ইনস্ট্যান্ট অ্যাপ্লিক্যান্ট শো করুন অথবা টোস্ট নোটিফিকেশন দিন
    console.log('New driver applied:', data.applicant.name);
    // React Query / State আপডেট:
    updateJobApplicantState(data.jobId, data.applicant);
  };

  socket.on('JOB_APPLICATION_RECEIVED', handleApplicationReceived);

  return () => {
    socket.off('JOB_APPLICATION_RECEIVED', handleApplicationReceived);
  };
}, []);
```

