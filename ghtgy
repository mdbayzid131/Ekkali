#### স্ক্রিন ৫: Real-Time Chat Screen (১-অন-১ চ্যাট)
চ্যাট স্ক্রিন ওপেন থাকলে কোনো পুল-ডাউন বা রিফ্রেশ ছাড়া মেসেজ লাইভ দেখা যাবে।

```typescript
// screens/ChatScreen.tsx
useEffect(() => {
  const socket = getSocket();
  if (!socket || !chatId) return;

  // ১. চ্যাট রুমে জয়েন করুন
  socket.emit('JOIN_CHAT', { chatId });

  // ২. নতুন মেসেজ রিসিভ করুন
  const handleNewMessage = ({ chatId: msgChatId, message }: any) => {
    if (msgChatId === chatId) {
      setMessages((prev) => [...prev, message]);
    }
  };

  socket.on('NEW_MESSAGE', handleNewMessage);

  return () => {
    socket.emit('LEAVE_CHAT', { chatId });
    socket.off('NEW_MESSAGE', handleNewMessage);
  };
}, [chatId]);
```

