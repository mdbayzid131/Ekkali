### ২. স্ক্রিন অনুযায়ী ইভেন্ট গাইডলাইন

#### স্ক্রিন ১: Available Jobs / Driver Feed Screen (ড্রাইভারদের জন্য)
এখানে কোনো রিফ্রেশ ছাড়া নতুন জব আসবে এবং অন্য কেউ নিয়ে নিলে রিমুভ হয়ে যাবে।

```typescript
// screens/AvailableJobsScreen.tsx
import { useEffect, useState } from 'react';
import { getSocket } from '../services/socket';

export const AvailableJobsScreen = () => {
  const [jobs, setJobs] = useState<Job[]>([]);

  useEffect(() => {
    const socket = getSocket();
    if (!socket) return;

    // ১. নতুন জব পোস্ট হলে ফিডের শীর্ষে যুক্ত হবে
    const handleJobCreated = ({ job }: { job: Job }) => {
      setJobs((prevJobs) => [job, ...prevJobs]);
    };

    // ২. কোনো জব অন্য কেউ নিয়ে নিলে বা ক্যান্সেল হলে ফিড থেকে সাথে সাথে মুছে যাবে
    const handleJobRemoved = ({ jobId }: { jobId: string }) => {
      setJobs((prevJobs) => prevJobs.filter((j) => j._id !== jobId));
    };

    socket.on('JOB_CREATED', handleJobCreated);
    socket.on('JOB_REMOVED_FROM_FEED', handleJobRemoved);

    return () => {
      socket.off('JOB_CREATED', handleJobCreated);
      socket.off('JOB_REMOVED_FROM_FEED', handleJobRemoved);
    };
  }, []);

  return (/* JSX */);
};
```

